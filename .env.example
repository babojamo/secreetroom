# Project Settings / API: publishable key (legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Server only, used by admin seed and account creation. Legacy SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"
# Connect dialog: transaction pooler for the app; URL-encode the database password.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Direct connection or session pooler (5432, IPv4 compatible) for migrations.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Use a real email address accepted by Supabase Auth.
ADMIN_EMAIL="admin@your-guild.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
DEMO_SEED="false"
# Set to your public HTTPS origin for production (no trailing slash).
APP_ORIGIN=""
